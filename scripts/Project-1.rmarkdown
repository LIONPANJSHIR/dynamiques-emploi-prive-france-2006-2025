```{r}
ggsave(
 filename = "../figures/gg_taille_secteurs.png",
 plot = gg_taille_secteurs,
 width = 20,
 height = 7,
 dpi = 300,
 bg = "white"
)
```

La taille moyenne des établissements varie fortement selon les secteurs. Hors spécificité de l'intérim, **l'industrie se distingue nettement avec environ 22,5 salariés par établissement**, contre **14,7 dans les services non marchands** et **9,3 dans les services marchands hors intérim**.

À l'inverse, l'**hôtellerie-restauration** compte seulement **6,4 salariés par établissement en moyenne**. Un établissement industriel emploie ainsi en moyenne **environ 3,5 fois plus de salariés** qu'un établissement de l'hôtellerie-restauration.

Ce résultat explique en partie le constat précédent : **le poids d'un secteur dans l'emploi dépend non seulement du nombre d'établissements qu'il regroupe, mais également de leur taille moyenne.**

### Quel région concentre le plus de salariés ?

```{r}

source_note <- md("**Données** : URSSAF <br> **Auteur** : Ly Amadou <br> **Outils** : R, gt, dplyr")

# subtitle <- md(
#   "L’<b>Île-de-France</b> concentre <b>22 % des établissements</b> et plus de <b>25 % des salariés</b> du secteur privé, confirmant son rôle de principal moteur économique du pays."
# )

table_region <- data |> 
 filter(annee == 2025) |>
 group_by(region) |> 
 summarise(
  total_eff = sum(effectifs_salaries, na.rm = TRUE),
  total_etab = sum(nb_etablissements, na.rm = TRUE),
  .groups = "drop"
 ) |> 
 mutate(
  prop_eff = total_eff / sum(total_eff),
  prop_etab = total_etab / sum(total_etab),
  
  slug_region = region |>
   stringi::stri_trans_general("Latin-ASCII") |>
   str_to_lower() |>
   str_replace_all("'", "") |>
   str_replace_all("[^a-z0-9]+", "-") |>
   str_replace_all("^-|-$", ""),
  
  logo_url = case_when(
   region == "Martinique" ~ "https://www.regions-et-departements.fr/images/logos-departements/972-logo-departement-martinique.png",
   region == "Guadeloupe" ~ "https://www.regions-et-departements.fr/images/logos-departements/971-logo-departement-guadeloupe.png",
   region == "Guyane" ~ "https://www.regions-et-departements.fr/images/logos-departements/973-logo-departement-guyane.png",
   region == "La Réunion" ~ "https://www.regions-et-departements.fr/images/logos-departements/974-logo-departement-la-reunion.png",
   
   TRUE ~ paste0(
    "https://www.regions-et-departements.fr/images/logos-regions/logo-",
    slug_region,
    ".png"
   )
  )
 ) |> 
 arrange(desc(prop_eff)) |> 
 mutate(Rang = row_number()) |> 
 select(
  Rang,
  logo_url,
  region,
  total_etab,
  prop_etab,
  total_eff,
  prop_eff
 )


idf <- table_region |>
 filter(region == "Île-de-France")

subtitle <- md(
 paste0(
  "En <b>2025</b>, l’<b>Île-de-France</b> concentre <b>",
  percent(idf$prop_etab, accuracy = 0.1, decimal.mark = ","),
  " des établissements</b> et <b>",
  percent(idf$prop_eff, accuracy = 0.1, decimal.mark = ","),
  " des salariés</b> du secteur privé."
 )
)

table_region_img <- table_region |> 
  gt(rowname_col = "Rang") |> 
 tab_header(
  title = md("**L’Île-de-France domine largement l’emploi privé français**"),
  subtitle = subtitle
 ) |> 
  tab_source_note(source_note = source_note) |> 
  text_transform(
    locations = cells_body(columns = logo_url),
    fn = function(x) {
      web_image(url = x, height = px(30))
    }
  ) |> 
  cols_label(
    logo_url = "",
    region = "Région",
    total_eff = "Effectifs salariés",
    prop_eff = "Part des salariés",
    total_etab = "Établissements",
    prop_etab = "Part des établissements"
  ) |> 
  fmt_number(
    columns = c(total_etab, total_eff),
    decimals = 0,
    sep_mark = " "
  ) |> 
  fmt_percent(
    columns = c(prop_etab, prop_eff),
    decimals = 2
  ) |> 
  data_color(
    columns = prop_eff,
    palette = c("#EAF2FF", "#1F4E79")
  ) |> 
  data_color(
    columns = prop_etab,
    palette = c("#FFF3E0", "#E67E22")
  ) |> 
  tab_row_group(
    label = "Régions majeures",
    rows = region %in% c("Île-de-France", "Auvergne-Rhône-Alpes")
  ) |> 
  tab_row_group(
    label = "Régions intermédiaires",
    rows = region %in% c(
      "Hauts-de-France",
      "Nouvelle-Aquitaine",
      "Grand Est",
      "Occitanie",
      "Provence-Alpes-Côte d'Azur",
      "Pays de la Loire",
      "Normandie",
      "Bretagne",
      "Bourgogne-Franche-Comté",
      "Centre-Val de Loire"
    )
  ) |> 
  tab_row_group(
    label = "Territoires ultramarins et insulaires",
    rows = region %in% c(
      "La Réunion",
      "Martinique",
      "Guadeloupe",
      "Corse",
      "Guyane"
    )
  ) |> 
  row_group_order(
    groups = c(
      "Régions majeures",
      "Régions intermédiaires",
      "Territoires ultramarins et insulaires"
    )
  ) |> 
  tab_style(
    locations = cells_body(
      columns = c(region, total_eff, prop_eff, total_etab, prop_etab)
    ),
    style = cell_text(
      font = google_font("Source Sans 3")
    )
  ) |> 
  tab_style(
    locations = cells_column_labels(everything()),
    style = cell_text(
      font = google_font("Source Sans 3"),
      weight = "bold"
    )
  ) |> 
  tab_options(
    table.font.names = "Source Sans 3",
    heading.title.font.size = px(22),
    heading.subtitle.font.size = px(13),
    data_row.padding = px(6),
    table.width = pct(100)
  )


