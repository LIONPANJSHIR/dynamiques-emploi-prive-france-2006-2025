### Quels secteurs dominent l'emploi privé ?

La forte concentration des établissements dans certains secteurs ne signifie pas nécessairement qu'ils concentrent également la majorité des emplois. Comparons donc le poids de chaque grand secteur dans les effectifs salariés.

```{r}
secteurs_eff_plot <- secteurs |>
 mutate(
  grand_secteur_activite = str_remove(
   grand_secteur_activite,
   "^GS[0-9]+\\s"
  ),
  
  grand_secteur_activite = fct_reorder(
   grand_secteur_activite,
   total_eff
  ),
  
  highlight = case_when(
   str_detect(
    grand_secteur_activite,
    "Autres services marchands"
   ) ~ "Leader",
   
   grand_secteur_activite == "Industrie" ~ "Industrie",
   
   TRUE ~ "Autres secteurs"
  ),
  
  label = paste0(
   label_number(
    scale = 1e-6,
    accuracy = 0.01,
    decimal.mark = ",",
    suffix = " M"
   )(total_eff),
   
   "  •  ",
   
   percent(
    prop_eff,
    accuracy = 0.1,
    decimal.mark = ","
   )
  )
 )


gg_effectifs_secteurs <- ggplot(
 secteurs_eff_plot,
 aes(
  x = total_eff,
  y = grand_secteur_activite,
  fill = highlight
 )
) +
 
 geom_col(
  width = 0.62,
  show.legend = FALSE
 ) +
 
 geom_text(
  aes(label = label),
  hjust = -0.08,
  size = 4.2,
  fontface = "bold",
  color = "#2B2B2B"
 ) +
 
 scale_x_continuous(
  labels = label_number(
   scale = 1e-6,
   suffix = " M",
   accuracy = 1,
   decimal.mark = ","
  ),
  
  breaks = c(
   0,
   50e6,
   100e6,
   150e6
  ),
  
  limits = c(
   0,
   max(secteurs_eff_plot$total_eff) * 1.25
  ),
  
  expand = expansion(
   mult = c(0, 0)
  )
 ) +
 
 scale_fill_manual(
  values = c(
   "Leader" = "#2563EB",
   "Industrie" = "#F59E0B",
   "Autres secteurs" = "#D9E2EC"
  )
 ) +
 
 labs(
  title = "Plus d’un salarié sur trois travaille dans les services marchands",
  
  subtitle = paste0(
   "Les services marchands concentrent 36,1 % des effectifs. ",
   "L’industrie se distingue également par un poids dans l’emploi ",
   "bien supérieur à son poids dans les établissements."
  ),
  
  x = NULL,
  y = NULL,
  
  caption = paste0(
   "Lecture : cumul annuel des effectifs salariés observés entre 2006 et 2025.\n",
   "Source : URSSAF • Traitement : analyse personnelle"
  )
 ) +
 
 theme_minimal(
  base_size = 13
 ) +
 
 theme(
  
  plot.background = element_rect(
   fill = "white",
   color = NA
  ),
  
  panel.background = element_rect(
   fill = "white",
   color = NA
  ),
  
  plot.title = element_text(
   size = 16,
   face = "bold",
   color = "#111827",
