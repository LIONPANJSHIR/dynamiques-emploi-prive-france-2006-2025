```{r}
#| include: false
region_performance <- region_evol |>
 filter(annee %in% c(2006, 2025)) |>
 pivot_wider(
  names_from = annee,
  values_from = total_salaries,
  names_prefix = "salaries_"
 ) |>
 mutate(
  # 1. Nombre de salariés supplémentaires
  creation_nette = salaries_2025 - salaries_2006,
  
  # 2. Croissance totale depuis 2006
  croissance_pct = 100 * (
   salaries_2025 / salaries_2006 - 1
  ),
  
  # 3. Taux de croissance annuel moyen
  tcam = 100 * (
   (salaries_2025 / salaries_2006)^(1 / (2025 - 2006)) - 1
  )
 ) |>
 arrange(desc(creation_nette))

region_performance <- region_performance |>
 mutate(
  contribution_creation = 
   creation_nette / sum(creation_nette) * 100
 ) |>
 arrange(desc(creation_nette))
```

