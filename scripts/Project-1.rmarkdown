#| include: false
font_add_google("Playfair Display", "playfair")
font_add_google("Source Sans 3", "source")
showtext_auto()
```

```{r}
#| label: carte-emploi-regional
#| fig-cap: "Répartition régionale de l’emploi salarié privé en France"
#| echo: false
#| warning: false
#| message: false


# ------------------------------------------------------------
# 1. Import des régions françaises
# ------------------------------------------------------------

regions_sf <- st_read(
 "https://raw.githubusercontent.com/gregoiredavid/france-geojson/master/regions-version-simplifiee.geojson",
 quiet = TRUE
)

# ------------------------------------------------------------
# 2. Sélection de la dernière année disponible
# ------------------------------------------------------------

latest_year <- max(data$annee, na.rm = TRUE)

# ------------------------------------------------------------
# 3. Agrégation des données par région
# ------------------------------------------------------------

data_region_map <- data |>
 filter(annee == latest_year) |>
 group_by(region) |>
 summarise(
  total_eff = sum(effectifs_salaries, na.rm = TRUE),
  total_etab = sum(nb_etablissements, na.rm = TRUE),
  .groups = "drop"
 ) |>
 mutate(
  prop_eff = total_eff / sum(total_eff, na.rm = TRUE),
  prop_etab = total_etab / sum(total_etab, na.rm = TRUE)
 )

# ------------------------------------------------------------
# 4. Calcul de la part de l'Île-de-France
# ------------------------------------------------------------

idf_share <- data_region_map |>
 filter(region == "Île-de-France") |>
 pull(prop_eff)

# ------------------------------------------------------------
# 5. Texte narratif dynamique
# ------------------------------------------------------------

story_text <- paste0(
 "L’**Île-de-France** concentre **",
 percent(idf_share, accuracy = 0.1),
 "** des salariés du secteur privé en **",
 latest_year,
 "**. La carte met en évidence une géographie économique fortement polarisée : ",
 "quelques régions concentrent une part importante de l’emploi national, ",
 "tandis que les territoires ultramarins et insulaires pèsent mécaniquement ",
 "moins dans le total."
)

# ------------------------------------------------------------
# 6. Jointure entre données économiques et géographiques
# ------------------------------------------------------------

map_region <- regions_sf |>
 left_join(
  data_region_map,
  by = c("nom" = "region")
 )

# ------------------------------------------------------------
# 7. Vérification des régions non appariées
# ------------------------------------------------------------

regions_non_matchees <- map_region |>
 st_drop_geometry() |>
 filter(is.na(prop_eff)) |>
 select(nom)

# Affichage uniquement s'il existe des régions non appariées
if (nrow(regions_non_matchees) > 0) {
 print(regions_non_matchees)
}

# ------------------------------------------------------------
# 8. Carte
# ------------------------------------------------------------

plot_eff_map <- ggplot(map_region) +
 
 geom_sf(
  aes(fill = prop_eff),
  colour = "#F8F4EA",
  linewidth = 0.35
 ) +
 
 scale_fill_gradientn(
  colours = c(
   "#F6E8C3",
   "#D9A441",
   "#C97B2B",
   "#8C2F39",
   "#0B1F33"
  ),
  labels = percent_format(accuracy = 1),
  na.value = "#DDD8CE",
  name = "Part des salariés"
 ) +
 
 labs(
  title = "L’Île-de-France domine la géographie de l’emploi salarié privé",
  subtitle = story_text,
  caption = paste0(
   "Données : URSSAF | Année : ",
   latest_year,
   " | Auteur : Ly Amadou | Outils : R, ggplot2, sf"
  )
 ) +
 
 theme_void(base_family = "source") +
 
 theme(
  plot.background = element_rect(
   fill = "#F7F3EA",
   colour = NA
  ),
  
  panel.background = element_rect(
   fill = "#F7F3EA",
   colour = NA
  ),
  
  legend.position = "left",
  
  legend.background = element_rect(
   fill = NA,
   colour = NA
  ),
  
  legend.title = element_text(
   family = "source",
   face = "bold",
   size = 10,
   colour = "#0B1F33"
  ),
  
  legend.text = element_text(
   family = "source",
   size = 9,
   colour = "#333333"
  ),
  
  plot.title = element_textbox_simple(
   family = "playfair",
   size = 12,
   face = "bold",
   colour = "#0B1F33",
   margin = margin(b = 7)
  ),
  
  plot.subtitle = element_textbox_simple(
   family = "source",
   size = 8,
   colour = "#5E5E5E",
   lineheight = 1.25,
   margin = margin(
    t = 10,
    b = 20
   )
  ),
  
  plot.caption = element_text(
   family = "source",
   size = 9,
   colour = "#6B6B6B",
   hjust = 0,
   margin = margin(t = 10)
  ),
  
  plot.margin = margin(
   t = 20,
   r = 25,
   b = 18,
   l = 25
  )
 )

# ------------------------------------------------------------
# 9. Affichage
# ------------------------------------------------------------

plot_eff_map

# ------------------------------------------------------------
# 10. Export haute résolution
# ------------------------------------------------------------

ggsave(
 filename = "../figures/emploi_salarie_prive.png",
 plot = plot_eff_map,
 width = 12,
 height = 8,
 units = "in",
 dpi = 300,
 bg = "#F7F3EA"
)
```

L’**Île-de-France** apparaît nettement comme le principal pôle d’emploi privé en France, devant les autres grandes régions métropolitaines. Cette concentration confirme une géographie de l’emploi fortement polarisée, mais le poids actuel d’une région ne renseigne pas nécessairement sur sa dynamique.

### Q**uelles régions ont créé le plus d’emplois depuis 2006 ?**

```{r}
region_evol <- data |> 
 group_by(annee, region) |> 
 summarise(
  total_salaries = sum(effectifs_salaries, na.rm = TRUE),
  .groups = "drop"
 )

lookup <- region_evol |> 
 filter(annee == 2006) |> 
 select(
  region,
  total_salaries_2006 = total_salaries
 )

new_plot_data <- region_evol |> 
 left_join(lookup, by = "region") |> 
 mutate(
  change = 100 * (
   total_salaries - total_salaries_2006
  ) / total_salaries_2006
 )

```

```{r}



gg_region_evolution <- ggplot(
 new_plot_data,
 aes(
  x = annee,
  y = change,
  color = region
 )
) +
 geom_hline(
  yintercept = 0,
  linewidth = 0.3,
  color = "grey65"
 ) +
 geom_line(
  linewidth = 0.9
 ) +
 facet_wrap(~ region, nrow = 3) +
 scale_color_viridis_d(direction = -1) +
 gghighlight(
  use_direct_label = FALSE,
  unhighlighted_params = list(
   colour = "grey85",
   linewidth = 0.5,
   alpha = 0.7
  )
 ) +
 scale_y_continuous(
  labels = label_percent(scale = 1),
  expand = expansion(mult = c(0.05, 0.12))
 ) +
 scale_x_continuous(
  breaks = seq(2006, 2025, by = 4)
 )+
 
 labs(
  title = "La dynamique de l’emploi diffère fortement selon les régions",
  
  subtitle = paste0(
   "Évolution des effectifs salariés privés par rapport ",
   "à leur niveau de 2006."
  ),
  
  x = NULL,
  y = "Variation depuis 2006",
  
  caption = paste0(
   "Base 2006 = 0 % • Données : URSSAF\n",
   "Auteur : Ly Amadou • Outils : R, ggplot2, dplyr"
  )
 ) +
 
 theme_minimal(
  base_size = 10,
  base_family = body_font
 ) +
 
 theme(
  legend.position = "none",
  
  plot.title.position = "plot",
  plot.caption.position = "plot",
  
  panel.spacing = unit(
   1.2,
   "lines"
  ),
  
  plot.background = element_rect(
   fill = bg_col,
   color = NA
  ),
  
  panel.background = element_rect(
   fill = bg_col,
   color = NA
  ),
  
  plot.title = element_textbox_simple(
   family = title_font,
   color = text_col,
   size = 18,
   face = "bold",
   lineheight = 1.05,
   margin = margin(b = 8)
  ),
  
  plot.subtitle = element_textbox_simple(
   family = body_font,
   color = "grey35",
   size = 10,
   lineheight = 1.2,
   margin = margin(b = 14)
  ),
  
  strip.text = element_text(
   family = body_font,
   face = "bold",
   color = text_col,
   size = 7.5
  ),
  
  axis.title.y = element_text(
   color = text_col,
   size = 8.5,
   margin = margin(r = 8)
  ),
  
  axis.text.x = element_text(
   color = "grey40",
   size = 6
  ),
  
  axis.text.y = element_text(
   color = "grey40",
   size = 6
  ),
  
  panel.grid.minor = element_blank(),
  
  panel.grid.major.x = element_line(
   color = "grey88",
   linetype = "dashed",
   linewidth = 0.3
  ),
  
  panel.grid.major.y = element_line(
   color = "grey90",
   linewidth = 0.3
  ),
  
  plot.caption = element_textbox_simple(
   family = body_font,
   hjust = 0,
   color = "grey45",
   size = 7,
   lineheight = 1.1,
   margin = margin(t = 12)
  ),
  
  plot.margin = margin(
   12,
   18,
   12,
   12
  )
 )

gg_region_evolution
```

Les dynamiques régionales révèlent d'importantes disparités. En volume, l'**Île-de-France** domine très largement avec près de **767 000 salariés supplémentaires entre 2006 et 2025**, représentant à elle seule environ **34,9 % de la création nette nationale d'emplois**.

Elle est suivie par **Auvergne-Rhône-Alpes (+322 000)** et l'**Occitanie (+269 000)**. Ensemble, ces trois régions représentent environ **61,8 % de la hausse nette de l'emploi observée sur la période**.

La lecture en pourcentage fait toutefois apparaître une géographie différente. Certains territoires ultramarins enregistrent les progressions relatives les plus importantes, notamment la **Guyane (+81,4 %)** et **La Réunion (+47,0 %)**, mais à partir de volumes d'emploi initialement beaucoup plus faibles.

À l'inverse, la **Bourgogne-Franche-Comté (-5,8 %)** et le **Grand Est (-2,8 %)** enregistrent un recul de leurs effectifs salariés entre 2006 et 2025.

Ces résultats montrent ainsi que **les régions qui concentrent ou créent le plus d'emplois en volume ne sont pas nécessairement celles qui connaissent la croissance relative la plus forte**.

